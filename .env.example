# Control plane
NEXT_PUBLIC_APP_URL=http://localhost:3000
RELAYFRAME_DEMO_MODE=true
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgres://relayframe:relayframe-local@localhost:5432/relayframe
REDIS_URL=redis://:relayframe-local-redis@localhost:6379

# S3-compatible media storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=relayframe-local
S3_ACCESS_KEY_ID=relayframe
S3_SECRET_ACCESS_KEY=relayframe-local-secret

# Billing (optional until Stripe is configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Generation worker
GENERATION_WORKER_CONCURRENCY=2
GENERATION_RATE_LIMIT=30

# External provider credentials are server-side only
IMAGE_PROVIDER_API_KEY=
VIDEO_PROVIDER_API_KEY=
